  --name ksc-postgres14 \
  --restart always \
  --network host \
  -e POSTGRES_PASSWORD='Password12' \
  -e POSTGRES_INITDB_ARGS="--locale=C --encoding=UTF8" \
  -v /var/lib/docker-postgresql/data:/var/lib/postgresql/data \
  postgres:14

